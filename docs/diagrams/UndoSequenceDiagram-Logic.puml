@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TAssistParser" as TAssistParser LOGIC_COLOR
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("undo")
activate LogicManager

LogicManager -> TAssistParser : parseCommand("undo")
activate TAssistParser

create UndoCommand
TAssistParser -> UndoCommand
activate UndoCommand

UndoCommand --> TAssistParser
deactivate UndoCommand

TAssistParser --> LogicManager : u
deactivate TAssistParser

LogicManager -> Model : getTAssistHistory()
activate Model

Model --> LogicManager : previousHistory
deactivate Model

LogicManager -> UndoCommand : execute(m)
activate UndoCommand

UndoCommand -> Model : undoTAssist()
activate Model

Model --> UndoCommand : description
deactivate Model

UndoCommand --> LogicManager : result
deactivate UndoCommand
'Hidden arrow to position the destroy marker below the end of the activation bar.
UndoCommand -[hidden]-> LogicManager
destroy UndoCommand

LogicManager -> Storage : saveTAssist(data)
activate Storage

Storage --> LogicManager
deactivate Storage

[<--LogicManager : result
deactivate LogicManager
@enduml
