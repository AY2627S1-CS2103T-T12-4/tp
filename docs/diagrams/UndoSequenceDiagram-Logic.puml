@startuml
!include style.puml
skinparam ArrowFontStyle plain
title Proposed undo: successful restoration and save

participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":UndoRedoHistory" as History LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR

[-> LogicManager : handle undo request
activate LogicManager
note over LogicManager, History
  Proposed flow, not implemented.
  A previous entry exists; startup data is not protected.
  The pre-command model copy is retained for recovery.
end note

LogicManager -> History : peekUndo()
activate History
History --> LogicManager : target snapshot copy
deactivate History

LogicManager -> Model : setTAssist(target)
activate Model
Model --> LogicManager
deactivate Model

LogicManager -> Storage : saveTAssist(target)
activate Storage
Storage --> LogicManager : save succeeds
deactivate Storage

LogicManager -> History : confirmUndo()
activate History
History --> LogicManager : index moved to previous entry
deactivate History

[<-- LogicManager : saved confirmation with command description
deactivate LogicManager

note over LogicManager, Storage
  On save failure, restore the pre-command model.
  Leave the file, history entries, and index unchanged.
end note
@enduml
