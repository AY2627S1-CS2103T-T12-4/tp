@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:User enters a valid command;
:Command executes;

'Since the beta syntax does not support placing the condition outside the
'diamond we place it as the true branch instead.

if () then ([data changed])
    :Save data to the data file;
    if () then ([not undo or redo])
        :Record previous data
        and command in history;
        :Discard undone changes;
    else ([else])
    endif
else ([else])
endif
stop
@enduml
