@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "d:StudentDeleteCommand" as Command LOGIC_COLOR
end box

[-> MainWindow : executeCommand(input)
activate MainWindow

MainWindow -> LogicManager : getConfirmationPrompt(input)
activate LogicManager

ref over LogicManager, Command : parse student delete

LogicManager -> Command : getConfirmationPrompt(model)
activate Command

note left of Command
  Builds the prompt from the
  student in the active group,
  changing no data.
end note

Command --> LogicManager : prompt
deactivate Command
'Hidden arrow to position the destroy marker below the end of the activation bar.
Command -[hidden]-> LogicManager
destroy Command

LogicManager --> MainWindow : prompt
deactivate LogicManager

MainWindow -> MainWindow : ask TA to confirm
activate MainWindow

note right of MainWindow
  Shows the prompt in a
  dialog whose default
  button is Cancel.
end note

MainWindow --> MainWindow : confirmed
deactivate MainWindow

alt confirmed
  MainWindow -> LogicManager : execute(input)
  activate LogicManager

  note right of LogicManager
    Parses input into a new
    command, runs it and
    saves the change.
  end note

  LogicManager --> MainWindow : r
  deactivate LogicManager
else cancelled
  note right of MainWindow
    Shows the cancelled
    message without
    executing input.
  end note
end

[<-- MainWindow : result
deactivate MainWindow
@enduml
