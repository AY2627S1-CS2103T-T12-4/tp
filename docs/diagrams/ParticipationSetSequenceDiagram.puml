@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "p:ParticipationSetCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "g:Group" as Group MODEL_COLOR
participant "s:Student" as Student MODEL_COLOR
participant "u:Student" as Updated MODEL_COLOR
end box

[-> LogicManager : execute(input)
activate LogicManager

ref over LogicManager, Command : parse participation set

LogicManager -> Command : execute(m)
activate Command

Command -> Model : getActiveGroup()
activate Model
Model --> Command : g
deactivate Model

Command -> Group : findStudent(A0123456X)
activate Group
Group --> Command : s
deactivate Group

Command -> Student : withParticipationRecord(3, 2)
activate Student

create Updated
Student -> Updated
activate Updated
Updated --> Student
deactivate Updated

Student --> Command : u
deactivate Student

Command -> Model : setStudent(T01, u)
activate Model
Model --> Command
deactivate Model

Command --> LogicManager : r
deactivate Command
'Hidden arrow to position the destroy marker below the end of the activation bar.
Command -[hidden]-> LogicManager
destroy Command

note right of LogicManager
  Saves the changed data,
  then returns r.
end note

[<-- LogicManager : r
deactivate LogicManager
@enduml
