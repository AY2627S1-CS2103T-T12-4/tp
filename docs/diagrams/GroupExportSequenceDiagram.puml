@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:GroupExportCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "e:GroupRecordsCsvExporter" as Exporter STORAGE_COLOR
end box

box Commons #DDDDDD
participant "<<class>>\nCsvUtil" as CsvUtil #555555
end box

[-> LogicManager : execute("group export")
activate LogicManager

ref over LogicManager, Command : parse group export

LogicManager -> Command : execute(m)
activate Command

Command -> Model : getActiveGroup()
activate Model
Model --> Command : g
deactivate Model

Command -> Exporter : export(g)
activate Exporter

Exporter -> Exporter : toRows(g)
activate Exporter
Exporter --> Exporter : rows
deactivate Exporter

Exporter -> CsvUtil : formatTable(rows)
activate CsvUtil
CsvUtil --> Exporter : csv
deactivate CsvUtil

note right of Exporter
  Writes the BOM and csv to a
  temporary file in the exports
  folder, then moves it over
  T01-records.csv in one step.
end note

Exporter --> Command : path
deactivate Exporter

Command --> LogicManager : r
deactivate Command
'Hidden arrow to position the destroy marker below the end of the activation bar.
Command -[hidden]-> LogicManager
destroy Command

note right of LogicManager
  The data is unchanged,
  so nothing is saved.
end note

[<-- LogicManager : r
deactivate LogicManager
@enduml
