<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="content-card" minHeight="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox styleClass="card-heading" alignment="CENTER_LEFT" spacing="10">
    <Label fx:id="groupTitle" styleClass="section-title" minWidth="0" HBox.hgrow="SOMETIMES" />
    <Label fx:id="studentCount" styleClass="count-badge" minWidth="-Infinity" />
    <Region HBox.hgrow="ALWAYS" />
  </HBox>
  <Label fx:id="recordHint"
         text="Recorded weeks and assignments appear as columns. Scroll right for more; hover for full values."
         styleClass="muted, record-hint" wrapText="true" />
  <StackPane VBox.vgrow="ALWAYS" minHeight="0">
    <TableView fx:id="studentTable" minHeight="0" editable="false" />
    <VBox fx:id="emptyState" alignment="CENTER" spacing="8" styleClass="empty-state">
      <Label fx:id="emptyTitle" styleClass="empty-title" wrapText="true" maxWidth="460" />
      <Label fx:id="emptyHint" styleClass="muted" wrapText="true" maxWidth="460" />
    </VBox>
  </StackPane>
</VBox>
