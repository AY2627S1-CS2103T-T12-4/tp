<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="content-card" minHeight="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <VBox styleClass="card-heading" spacing="4">
    <Label text="Local data" styleClass="section-title" />
    <Label text="Automatic persistence" styleClass="muted" />
  </VBox>
  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" minHeight="0" hbarPolicy="NEVER">
    <VBox styleClass="storage-content" spacing="16">
      <Label text="Your records stay on this computer" styleClass="empty-title" wrapText="true" />
      <Label text="Commands that change data save your groups, students, weekly records, assignment submissions and grades, and active group. The footer confirms each successful save."
             wrapText="true" styleClass="muted" />
      <Label text="DATA FILE" styleClass="eyebrow" />
      <Label fx:id="filePath" styleClass="file-path" wrapText="true" maxWidth="Infinity" />
      <Label text="The file is created after the first successful data change. A first launch starts empty."
             wrapText="true" styleClass="muted" />
      <Label text="Close TAssist before editing the file manually. If loading fails, the file is protected. Repair or move it, then restart."
             wrapText="true" styleClass="muted" />
      <Label text="Assignment names, submissions, and grades are saved in this file."
             wrapText="true" styleClass="muted" />
    </VBox>
  </ScrollPane>
</VBox>
