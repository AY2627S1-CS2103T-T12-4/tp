<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="content-card" minHeight="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox styleClass="card-heading" alignment="CENTER_LEFT" spacing="12">
    <Label text="Student roster" styleClass="section-title" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="recordCount" styleClass="muted" />
  </HBox>
  <Label text="Contact records · student IDs coming soon" styleClass="card-caption" wrapText="true" />
  <TableView fx:id="personTable" VBox.vgrow="ALWAYS" minHeight="0" editable="false">
    <placeholder>
      <VBox alignment="CENTER" spacing="8">
        <Label text="No contacts to display" styleClass="empty-title" />
        <Label text="Use list to show all contacts, or add to create one." wrapText="true" styleClass="muted" />
      </VBox>
    </placeholder>
  </TableView>
</VBox>
